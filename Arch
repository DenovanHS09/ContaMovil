name: Descomprimir y compilar
on:
  workflow_dispatch:
permissions:
  contents: write
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Descomprimir proyecto
        run: |
          unzip -q contamovil.zip
          rsync -a --exclude='.github' contamovil/ ./
          rm -rf contamovil contamovil.zip

      - name: Guardar codigo en el repositorio
        run: |
          git config user.name "github-actions"
          git config user.email "actions@github.com"
          git add -A
          git commit -m "Estructura inicial" || echo "Nada que guardar"
          git push

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "8.9"

      - name: Compilar APK
        run: gradle assembleDebug --stacktrace

      - uses: actions/upload-artifact@v4
        with:
          name: contamovil-debug-apk
          path: app/build/outputs/apk/debug/*.apk
